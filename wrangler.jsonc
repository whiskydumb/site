{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "whisky-sh",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "whisky.sh",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whisky-sh",
      "migrations_dir": "drizzle"
    }
  ]
}
