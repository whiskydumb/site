---
import BaseLayout from "~/layouts/BaseLayout.astro"
import Frame from "~/components/Frame.astro"

Astro.response.status = 404
---

<BaseLayout title="404 · whisky" noindex>
  <Frame>
    <div class="lost">
      <p class="face" aria-hidden="true">&gt;_&lt;</p>
      <p class="line">nothing here. maybe it never existed, maybe i broke it.</p>
      <nav class="ways" aria-label="ways out">
        <a href="/">home</a>
        <span aria-hidden="true">·</span>
        <a href="/rss.xml">rss</a>
      </nav>
    </div>
  </Frame>
</BaseLayout>

<style>
  .lost {
    display: grid;
    flex: 1;
    place-content: center;
    justify-items: center;
    gap: 1em;
    padding: clamp(22px, 2.4vw, 44px);
    text-align: center;
  }

  .face {
    margin: 0 0 0.3em;
    color: var(--accent);
    font-size: 5em;
    font-weight: 600;
    line-height: 1;
  }

  .line {
    margin: 0;
  }

  .ways {
    display: flex;
    gap: 0.6em;
    color: var(--muted);
    font-size: 0.9em;
  }

  .ways a {
    color: var(--accent);
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .ways a:hover {
    text-decoration-color: currentColor;
  }
</style>
