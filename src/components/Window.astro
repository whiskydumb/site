---
import About from "~/components/About.astro"
import Badges from "~/components/Badges.astro"
import Blog from "~/components/Blog.astro"
import Frame from "~/components/Frame.astro"
import Guestbook from "~/components/Guestbook.astro"

const TABS = ["about", "blog", "guestbook", "badges"] as const
---

<Frame>
  <img slot="roof" class="counter" data-counter width="216" height="80" alt="visit counter" />
  <div slot="bar" class="tabs" role="tablist">
    {
      TABS.map((tab, index) => (
        <button
          class="tab"
          type="button"
          role="tab"
          id={`tab-${tab}`}
          data-tab={tab}
          aria-controls={`panel-${tab}`}
          aria-selected={index === 0 ? "true" : "false"}
          tabindex={index === 0 ? 0 : -1}
        >
          {tab}
        </button>
      ))
    }
  </div>

  <div class="panels">
    {
      TABS.map((tab, index) => (
        <section
          class="panel"
          role="tabpanel"
          id={`panel-${tab}`}
          aria-labelledby={`tab-${tab}`}
          hidden={index !== 0}
        >
          {tab === "about" && <About />}
          {tab === "blog" && <Blog />}
          {tab === "guestbook" && <Guestbook />}
          {tab === "badges" && <Badges />}
        </section>
      ))
    }
  </div>
</Frame>

<script is:inline>
  {
    const tabs = [...document.querySelectorAll("[data-tab]")]

    const selectTab = (tab) => {
      for (const other of tabs) {
        const selected = other === tab
        other.setAttribute("aria-selected", String(selected))
        other.tabIndex = selected ? 0 : -1
        const panel = document.getElementById(other.getAttribute("aria-controls"))
        if (panel) panel.hidden = !selected
      }
    }

    const tabFromHash = () => tabs.find((tab) => `#${tab.dataset.tab}` === location.hash) ?? tabs[0]

    const KEY_STEPS = { ArrowRight: 1, ArrowLeft: -1 }

    const activate = (tab) => {
      selectTab(tab)
      history.replaceState(null, "", tab === tabs[0] ? location.pathname : `#${tab.dataset.tab}`)
    }

    for (const tab of tabs) {
      tab.addEventListener("keydown", (event) => {
        const index = tabs.indexOf(tab)
        const step = KEY_STEPS[event.key]
        const target =
          step !== undefined
            ? tabs[(index + step + tabs.length) % tabs.length]
            : event.key === "Home"
              ? tabs[0]
              : event.key === "End"
                ? tabs[tabs.length - 1]
                : null
        if (!target) return
        event.preventDefault()
        activate(target)
        target.focus()
      })

      tab.addEventListener("click", () => activate(tab))
    }

    selectTab(tabFromHash())
    addEventListener("hashchange", () => selectTab(tabFromHash()))
  }
</script>

<script>
  import { COUNTER } from "~/lib/consts"
  import { DEFAULT_PALETTE } from "~/lib/palettes"

  const counter = document.querySelector<HTMLImageElement>("[data-counter]")

  const counterSrc = (route: "get" | "record", theme: string) =>
    `${COUNTER.origin}/${route}/@${COUNTER.name}?theme=${theme}&pad=${COUNTER.pad}`

  if (counter) {
    const palette = document.documentElement.dataset.palette ?? DEFAULT_PALETTE
    counter.src = counterSrc(import.meta.env.DEV ? "record" : "get", palette)

    document.addEventListener("palettechange", (event) => {
      if (event instanceof CustomEvent && typeof event.detail === "string") {
        counter.src = counterSrc("record", event.detail)
      }
    })
  }
</script>

<style>
  .counter {
    position: absolute;
    bottom: 100%;
    right: 0.5em;
    width: auto;
    height: 80px;
    image-rendering: pixelated;
    filter: drop-shadow(2px 2px 2px rgb(0 0 0 / 0.7));
    transition: filter 0.2s;
  }

  .counter:not([src]) {
    visibility: hidden;
  }

  .counter:hover {
    filter: drop-shadow(6px 6px 2px rgb(0 0 0 / 0.7));
  }

  .tabs {
    display: flex;
  }

  .tab {
    padding: 0.7em 1.1em;
    background: none;
    border: none;
    border-left: 1px solid var(--line);
    color: var(--muted);
    font: inherit;
    cursor: var(--cursor-pointer, pointer);
    transition:
      color 0.35s,
      background-color 0.35s,
      border-color 0.35s;
  }

  .tab:hover {
    color: var(--fg);
  }

  .tab[aria-selected="true"] {
    color: var(--bg);
    background: var(--accent);
  }

  .panels {
    display: grid;
    flex: 1;
  }

  .panel {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    padding: clamp(22px, 2.4vw, 44px);
  }

  .panel[hidden] {
    display: flex;
    visibility: hidden;
  }
</style>
