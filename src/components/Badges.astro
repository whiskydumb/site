---
const SLOTS: readonly string[] = []

const BUTTON_CODE =
  '<a href="https://whisky.sh"><img src="https://whisky.sh/88x31.gif" width="88" height="31" alt="whisky.sh"></a>'
---

<div class="badges">
  <div class="wall" data-wall>
    {
      SLOTS.map((caption) => (
        <div class="slot" tabindex="0" data-caption={caption}>
          88×31
        </div>
      ))
    }
    <span class="caption" data-caption-out aria-live="polite"></span>
  </div>

  <footer class="foot">
    <button class="copy" type="button" data-copy-button data-code={BUTTON_CODE} aria-live="polite">copy my button</button>
  </footer>
</div>

<script>
  const wall = document.querySelector<HTMLElement>("[data-wall]")
  const caption = wall?.querySelector<HTMLElement>("[data-caption-out]")

  if (wall && caption) {
    for (const slot of wall.querySelectorAll<HTMLElement>("[data-caption]")) {
      const show = () => {
        caption.textContent = slot.dataset.caption ?? ""
      }
      slot.addEventListener("mouseenter", show)
      slot.addEventListener("focus", show)
    }
    wall.addEventListener("mouseleave", () => {
      caption.textContent = ""
    })
  }

  const copy = document.querySelector<HTMLButtonElement>("[data-copy-button]")
  let reset: ReturnType<typeof setTimeout> | undefined

  copy?.addEventListener("click", async () => {
    const label = "copy my button"
    try {
      await navigator.clipboard.writeText(copy.dataset.code ?? "")
      copy.textContent = "copied"
    } catch {
      copy.textContent = "copy failed"
    }
    clearTimeout(reset)
    reset = setTimeout(() => {
      copy.textContent = label
    }, 2000)
  })
</script>

<style>
  .badges {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 1em;
  }

  .wall {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    padding-bottom: 1.6em;
  }

  .slot {
    display: grid;
    place-items: center;
    width: 88px;
    height: 31px;
    border: 1px dashed var(--line);
    color: var(--muted);
    font-size: 10px;
    opacity: 0.8;
    transition:
      opacity 0.6s,
      transform 0.15s,
      border-color 0.35s;
  }

  .slot:hover,
  .slot:focus-visible {
    opacity: 1;
    transform: scale(1.05);
    transition:
      opacity 0.1s,
      transform 0.15s;
  }

  .caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    text-align: center;
    color: var(--accent);
    font-size: 0.8em;
    pointer-events: none;
  }

  .foot {
    display: flex;
    justify-content: center;
    margin-top: auto;
    font-size: 0.8em;
  }

  .copy {
    padding: 0;
    background: none;
    border: none;
    color: var(--muted);
    font: inherit;
    text-decoration: underline dotted;
    text-underline-offset: 3px;
    cursor: var(--cursor-pointer, pointer);
  }

  .copy:hover {
    color: var(--accent);
  }
</style>
