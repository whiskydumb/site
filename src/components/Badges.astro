---
interface Badge {
  readonly src: string
  readonly alt: string
  readonly href?: string
}

const BADGES: readonly Badge[] = [
  { src: "/88x31.gif", alt: "whisky.sh" },
  { src: "/88x31/underwear-is-for-losers.gif", alt: "underwear is for losers!" },
  { src: "/88x31/piracy-now.gif", alt: "piracy now!" },
  { src: "/88x31/ublock-origin.png", alt: "uBlock Origin now!", href: "https://ublockorigin.com/" },
  { src: "/88x31/nixos.png", alt: "powered by NixOS", href: "https://nixos.org/" },
  { src: "/88x31/matrix.png", alt: "Matrix", href: "https://matrix.org/" },
  { src: "/88x31/archive-org.png", alt: "Internet Archive", href: "https://archive.org/" },
]

const BUTTON_CODE =
  '<a href="https://whisky.sh"><img src="https://whisky.sh/88x31.gif" width="88" height="31" alt="whisky.sh"></a>'
---

<div class="badges">
  <div class="wall" data-wall>
    {
      BADGES.map(({ src, alt, href }) =>
        href ? (
          <a class="slot" href={href} target="_blank" rel="noopener" data-caption={alt}>
            <img src={src} alt={alt} width="88" height="31" loading="lazy" decoding="async" />
          </a>
        ) : (
          <span class="slot" data-caption={alt}>
            <img src={src} alt={alt} width="88" height="31" loading="lazy" decoding="async" />
          </span>
        ),
      )
    }
    <span class="caption" data-caption-out aria-live="polite"></span>
  </div>

  <footer class="foot">
    <button class="copy" type="button" data-copy-button data-code={BUTTON_CODE} aria-live="polite">copy my button</button>
  </footer>
</div>

<script>
  const wall = document.querySelector<HTMLElement>("[data-wall]")
  const caption = wall?.querySelector<HTMLElement>("[data-caption-out]")

  if (wall && caption) {
    for (const slot of wall.querySelectorAll<HTMLElement>("[data-caption]")) {
      const show = () => {
        caption.textContent = slot.dataset.caption ?? ""
      }
      slot.addEventListener("mouseenter", show)
      slot.addEventListener("focus", show)
    }
    wall.addEventListener("mouseleave", () => {
      caption.textContent = ""
    })
  }

  const copy = document.querySelector<HTMLButtonElement>("[data-copy-button]")
  let reset: ReturnType<typeof setTimeout> | undefined

  copy?.addEventListener("click", async () => {
    const label = "copy my button"
    try {
      await navigator.clipboard.writeText(copy.dataset.code ?? "")
      copy.textContent = "copied"
    } catch {
      copy.textContent = "copy failed"
    }
    clearTimeout(reset)
    reset = setTimeout(() => {
      copy.textContent = label
    }, 2000)
  })
</script>

<style>
  .badges {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 1em;
  }

  .wall {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    padding-bottom: 1.6em;
  }

  .slot {
    display: block;
    width: 88px;
    height: 31px;
    opacity: 0.8;
    transition:
      opacity 0.6s,
      transform 0.15s;
  }

  .slot:hover,
  .slot:focus-visible {
    opacity: 1;
    transform: scale(1.05);
    transition:
      opacity 0.1s,
      transform 0.15s;
  }

  .slot img {
    display: block;
    image-rendering: pixelated;
  }

  .caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    text-align: center;
    color: var(--accent);
    font-size: 0.8em;
    pointer-events: none;
  }

  .foot {
    display: flex;
    justify-content: center;
    margin-top: auto;
    font-size: 0.8em;
  }

  .copy {
    padding: 0;
    background: none;
    border: none;
    color: var(--muted);
    font: inherit;
    text-decoration: underline dotted;
    text-underline-offset: 3px;
    cursor: var(--cursor-pointer, pointer);
  }

  .copy:hover {
    color: var(--accent);
  }
</style>
