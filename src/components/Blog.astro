---
import { postDate } from "~/lib/dates"
import { getPosts, postUrl, readingMinutes } from "~/lib/posts"

const posts = await getPosts()
---

<div class="blog">
  <div class="scroll" data-blog-scroll>
    <ul class="posts" data-blog-posts>
      {
        posts.map((post) => {
          const date = postDate(post.data.date)
          return (
            <li class="post">
              <h3>
                <a href={postUrl(post)}>{post.data.title}</a>
              </h3>
              <div class="meta">
                <time datetime={date.iso}>
                  {date.month} {date.day}
                  <sup>{date.suffix}</sup>, {date.year}
                </time>
                <span>{readingMinutes(post)} min read</span>
                {post.data.draft && <span class="draft">draft</span>}
              </div>
              <p>{post.data.description}</p>
            </li>
          )
        })
      }
    </ul>
  </div>

  <footer class="foot">
    <a href="/rss.xml">rss</a>
    <button type="button" data-blog-sort aria-label="post order">newest first ↓</button>
  </footer>
</div>

<script>
  const scroll = document.querySelector<HTMLElement>("[data-blog-scroll]")
  const list = document.querySelector<HTMLElement>("[data-blog-posts]")
  const sort = document.querySelector<HTMLButtonElement>("[data-blog-sort]")

  const syncFade = () => {
    if (!scroll) return
    scroll.classList.toggle("at-end", scroll.scrollTop + scroll.clientHeight >= scroll.scrollHeight - 4)
  }

  scroll?.addEventListener("scroll", syncFade, { passive: true })
  syncFade()

  let newestFirst = true
  sort?.addEventListener("click", () => {
    if (!list || !scroll) return
    newestFirst = !newestFirst
    sort.textContent = newestFirst ? "newest first ↓" : "oldest first ↑"
    list.append(...[...list.children].reverse())
    scroll.scrollTop = 0
    syncFade()
  })
</script>

<style>
  .blog {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 1em;
  }

  .scroll {
    max-height: 27em;
    padding-right: 0.8em;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
    mask-image: linear-gradient(#000 calc(100% - 3em), transparent);
  }

  .scroll.at-end {
    mask-image: none;
  }

  .posts {
    display: grid;
    gap: 1.6em;
    margin: 0;
    padding: 0 0 1.5em;
    list-style: none;
  }

  h3 {
    margin: 0 0 0.25em;
    font-size: 1.3em;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  h3 a {
    color: var(--fg);
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--accent);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.6em;
    color: var(--muted);
    font-size: 0.78em;
  }

  .meta span::before {
    content: "·";
    margin-right: 0.6em;
    color: var(--line);
  }

  .meta sup {
    font-size: 0.7em;
  }

  .meta .draft {
    color: var(--accent);
  }

  .post p {
    margin: 0.45em 0 0;
    color: color-mix(in srgb, var(--fg) 78%, var(--bg));
    font-size: 0.95em;
  }

  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1em;
    margin-top: auto;
    font-size: 0.85em;
  }

  .foot a,
  .foot button {
    padding: 0;
    background: none;
    border: none;
    color: var(--muted);
    font: inherit;
    text-decoration: none;
    cursor: var(--cursor-pointer, pointer);
  }

  .foot a:hover,
  .foot button:hover {
    color: var(--accent);
  }
</style>
